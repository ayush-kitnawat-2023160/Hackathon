# Copy to .env and fill in. .env is in .gitignore and must never be committed.
LLM_PROVIDER=anthropic          # anthropic | ollama
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
MOCK_LLM=true                   # true = rules and templates, no model calls
DB_PATH=allocator.db
API_URL=http://localhost:8000
ADMIN_TOKEN=                    # if set, POST /ingest requires header X-Admin-Token
